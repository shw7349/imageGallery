# 로컬 개발용 예시. `cp .env.example .env` 후 사용한다 (make up이 없으면 자동 복사).
# 운영 값은 EC2의 /opt/gallery/.env(권한 600)에 둔다 — docs/RUNBOOK.md (14단계)

ENV=local
LOG_LEVEL=INFO

# DB (docker-compose.yml의 postgres). 테스트는 이름 뒤에 _test를 붙인 DB를 자동 사용한다.
DATABASE_URL=postgresql+psycopg://gallery:gallery@localhost:5432/gallery

# S3 — 로컬은 MinIO. 운영은 S3_ENDPOINT_URL·키를 비우고 IAM 역할을 쓴다.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ORIGINALS_BUCKET=gallery-originals
S3_DERIVED_BUCKET=gallery-derived
CDN_BASE_URL=http://localhost:9000/gallery-derived

# 32자 이상 임의 문자열. 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-local-dev-only-change-me-local-dev-only

# 관리자 전용 도메인(쉼표 구분). 이 Host로 온 요청만 /api/admin/*을 쓸 수 있고, 다른 도메인에서는 404.
# 비우면 제한 없음(로컬 개발용). 운영(ENV=prod)에서는 필수.
ADMIN_HOSTS=

# 쉼표 구분
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 조회수·통계: 일별 집계 시간대, IP당 분당 조회수 기록 한도, 중복 제거 기록 보관 일수
STATS_TIMEZONE=Asia/Seoul
VIEWS_RATE_PER_MINUTE=60
VIEW_DEDUPE_RETENTION_DAYS=30


# 워커·작업 큐 (docs/adr/0002-job-queue.md)
WORKER_CONCURRENCY=1
JOB_RETRY_DELAYS_SECONDS=60,300,900
JOB_STALE_AFTER_SECONDS=1800
WORK_DIR=/tmp/gallery-work
# libvips 스레드·캐시 제한(워커 메모리 상한). 300MB TIFF 기준 최대 메모리 약 200MB
VIPS_CONCURRENCY=2
VIPS_CACHE_MAX_MB=100
